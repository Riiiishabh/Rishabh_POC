{
  "name": "rishabh-qa-assignment-ai",
  "version": "1.0.0",
  "description": "Playwright automation suite for Practice Software Testing Toolshop — Rishabh QA Assignment AI",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test tests/ui",
    "test:ui:smoke": "playwright test tests/ui/smoke --grep @smoke",
    "test:ui:regression": "playwright test tests/ui/regression --grep @regression",
    "test:api": "playwright test tests/api",
    "test:api:smoke": "playwright test tests/api/smoke --grep @smoke",
    "test:api:regression": "playwright test tests/api/regression --grep @regression",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report reports/html",
    "install:browsers": "playwright install chromium --with-deps"
  },
  "keywords": [],
  "author": "Rishabh Mishra",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "dotenv": "17.4.2"
  }
}
